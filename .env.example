# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-在这里填你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据库（Day 5 迁移 pgvector 时才用得上）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb

# 检索参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# 拒答阈值：检索最高相似度低于这个值就不回答，避免编造。
# 0.51 不是拍脑袋定的 —— 用 calibrate_threshold.py 跑过 8 个该答 + 6 个该拒的问题，
# 实测该答的最低 0.5830、该拒的最高 0.4330，取了这道缝的中间。
# 换了文档集要重新跑一遍校准，这个数不能跨数据集复用。
SCORE_THRESHOLD=0.51
